    status_html = (
        '<span class="status-badge status-speaking">🔊 Speaking Response...</span>'
        if is_speaking else
        '<span class="status-badge status-idle">✨ Ready to Assist (HK Only)</span>'
    )
    avatar_html = f"""
    <div class="avatar-card">
        <svg width="110" height="110" viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">
            <circle cx="60" cy="60" r="56" fill="#e0f2fe" stroke="#0284c7" stroke-width="3"/>
            <path d="M24 112 C24 88, 96 88, 96 112" fill="#1e3a8a"/>
            <path d="M50 90 L60 105 L70 90 Z" fill="#ffffff"/>
            <polygon points="60,92 56,102 64,102" fill="#dc2626"/>
            <circle cx="60" cy="56" r="26" fill="#1e293b"/>
            <circle cx="60" cy="60" r="22" fill="#fde68a"/>
            <ellipse cx="60" cy="37" rx="22" ry="6" fill="#1e3a8a"/>
            <rect x="44" y="25" width="32" height="12" rx="4" fill="#1e3a8a"/>
            <rect x="44" y="33" width="32" height="3" fill="#f59e0b"/>
            <circle cx="52" cy="58" r="2.8" fill="#0f172a"/>
            <circle cx="68" cy="58" r="2.8" fill="#0f172a"/>
            <circle cx="53" cy="57" r="1" fill="#ffffff"/>
            <circle cx="69" cy="57" r="1" fill="#ffffff"/>
            <ellipse cx="46" cy="65" rx="3.5" ry="2" fill="#fda4af" opacity="0.7"/>
            <ellipse cx="74" cy="65" rx="3.5" ry="2" fill="#fda4af" opacity="0.7"/>
