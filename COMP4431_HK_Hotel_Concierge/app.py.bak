BASE_DIR = os.path.dirname(os.path.abspath(__file__))

@st.cache_resource
def load_knowledge_base(kb_folder=None):
    if kb_folder is None:
        kb_folder = os.path.join(BASE_DIR, "knowledge_base")
    hotels_df = pd.read_csv(os.path.join(kb_folder, "01_HK_Hotels_Master_Database.csv"))
    documents = []

    for _, row in hotels_df.iterrows():
        total_rate = round(row["Base_Rate_HKD"] * 1.13)
        chunk_text = (
            f"Hotel: {row['Hotel_Name']} | District: {row['District']} ({row['Area']}) | "
            f"Tier: {row['Tier']} ({row['Star_Rating']} Stars) | "
            f"Base Rate: HK${row['Base_Rate_HKD']}/night (Total incl. 10% service + 3% HK Hotel Tax: HK${total_rate}/night) | "
            f"Nearest MTR: {row['Nearest_MTR']} ({row['MTR_Walk_Min']} min walk) | "
            f"Harbour View: {row['Harbour_View']} | Pool: {row['Swimming_Pool']} | "
            f"Family Friendly: {row['Family_Friendly']} | Pet Friendly: {row['Pet_Friendly']} | "
            f"Best For: {row['Best_For']} | Highlights: {row['Key_Highlights']}"
        )
        documents.append({
            "source": "01_HK_Hotels_Master_Database.csv",
            "title": row["Hotel_Name"],
            "content": chunk_text
        })

    for md_path in sorted(glob.glob(os.path.join(kb_folder, "*.md"))):
        fname = os.path.basename(md_path)
        with open(md_path, "r", encoding="utf-8") as f:
            text = f.read()
        sections = re.split(r"\n(?=## )", text)
        for sec in sections:
            clean_sec = sec.strip()
            if clean_sec:
                first_line = clean_sec.splitlines()[0].replace("#", "").strip()
                documents.append({
                    "source": fname,
                    "title": first_line,
                    "content": clean_sec
                })

    corpus = [d["title"] + " " + d["content"] for d in documents]
    vectorizer = TfidfVectorizer(stop_words="english", ngram_range=(1, 2))
    tfidf_matrix = vectorizer.fit_transform(corpus)
    return hotels_df, documents, vectorizer, tfidf_matrix

hotels_df, kb_docs, vectorizer, tfidf_matrix = load_knowledge_base()

def retrieve_context(query: str, top_k: int = 5):
    q_vec = vectorizer.transform([query])
    sims = cosine_similarity(q_vec, tfidf_matrix).flatten()
    top_indices = sims.argsort()[::-1][:top_k]
    results = []
    for idx in top_indices:
        results.append({
            "source": kb_docs[idx]["source"],
            "title": kb_docs[idx]["title"],
            "content": kb_docs[idx]["content"],
            "score": round(float(sims[idx]), 3)
        })
    return results

def filter_hotels(df, max_budget, districts, require_harbour, require_pool, require_family, require_pet):
    filtered = df.copy()
    filtered["Total_Nightly_HKD"] = (filtered["Base_Rate_HKD"] * 1.13).round(0).astype(int)
    filtered = filtered[filtered["Base_Rate_HKD"] <= max_budget]
    if districts and "All Districts" not in districts:
        filtered = filtered[filtered["District"].isin(districts)]
    if require_harbour:
        filtered = filtered[filtered["Harbour_View"].isin(["Yes", "Partial"])]
    if require_pool:
        filtered = filtered[filtered["Swimming_Pool"] == "Yes"]
    if require_family:
        filtered = filtered[filtered["Family_Friendly"] == "Yes"]
    if require_pet:
        filtered = filtered[filtered["Pet_Friendly"] == "Yes"]
    return filtered.sort_values(by=["Star_Rating", "Base_Rate_HKD"], ascending=[False, True])

